# ========================================================
# SMART WASH — Production & Development Environment Config
# ========================================================

# --------------------------------------------------------
# Frontend Configuration (Vercel / Local Vite)
# --------------------------------------------------------
# 1. Backend API Base URL (HTTPS)
# In production on Vercel, set this to your deployed Render service URL:
# Example: https://smart-wash-backend.onrender.com
# For local development, leave empty to automatically connect to http://localhost:4550
VITE_API_URL=

# 2. Backend WebSocket URL (WSS)
# Optional: If omitted, the frontend automatically derives this from VITE_API_URL (e.g. wss://.../ws_model)
# Example: wss://smart-wash-backend.onrender.com/ws_model
# For local development, leave empty to automatically connect to ws://localhost:4550/ws_model
VITE_WS_URL=

# --------------------------------------------------------
# Backend Configuration (Render / Railway / Docker / Local)
# --------------------------------------------------------
# Port and Host (Render automatically assigns $PORT at runtime)
PORT=4550
HOST=0.0.0.0

# CORS Allowed Origins
# Comma-separated list of origins allowed to communicate with the FastAPI backend.
# In production, specify your deployed Vercel domain(s):
# Example: https://smart-wash.vercel.app,http://localhost:3000,http://localhost:3002
# Setting to * allows all origins (ideal for final-year project demos).
CORS_ORIGINS=*

# Optional Model Directory Override (defaults to backend/models/lstm)
# SMART_WASH_MODEL_DIR=

# --------------------------------------------------------
# Firebase Firestore & Storage Configuration (Persistent Database)
# --------------------------------------------------------
# Set your Firebase Web App credentials to persist student records, sessions,
# compliance streaks, and face descriptors in the cloud.
# NOTE: If left blank, SMART WASH runs in local offline mode (browser localStorage).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
